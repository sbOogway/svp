#!/usr/bin/env bash
# Full local CI before anything leaves this machine.
# (Pages publishing lives in post-merge: main is protected, so it is only ever
#  updated by pulling a merged PR, never by a direct push.)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a branch: nothing to check.
  [[ "$local_sha" =~ ^0+$ ]] && exit 0
done

echo "pre-push: running full CI (make ci)"
make ci
