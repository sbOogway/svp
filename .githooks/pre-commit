#!/usr/bin/env bash
# Fast checks on the areas touched by this commit. Full CI runs in pre-push.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if grep -qE '^(backend/|rust-toolchain\.toml)' <<<"$staged"; then
  echo "pre-commit: backend fmt + clippy"
  make fmt
  (cd backend && cargo clippy --workspace --all-targets -- -D warnings)
fi
if grep -qE '^frontend/' <<<"$staged"; then
  echo "pre-commit: frontend typecheck + lint"
  make typecheck
  (cd frontend && npm run lint)
fi
