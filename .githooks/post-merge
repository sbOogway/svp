#!/usr/bin/env bash
# After `git pull` on main: publish the frontend to GitHub Pages if it changed.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

[[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] || exit 0
if git diff --name-only ORIG_HEAD HEAD -- frontend/ | grep -q .; then
  echo "post-merge: frontend changed on main -> publishing to GitHub Pages"
  ./scripts/deploy-pages.sh
else
  echo "post-merge: no frontend changes, Pages untouched"
fi
